/* ── The editor canvas ────────────────────────────────────────────────────── */

/* The theme's own stylesheet is loaded before this one, so a section previews
   as the page will show it. What follows undoes the parts that only make sense
   while a real page is being scrolled, and dresses the editing that sits
   around the preview. */

/* Every reveal is a scroll-driven animation held at its first frame — opacity
   zero — until the element enters the viewport. In a canvas that scrolls to
   its own rules, that leaves sections blank, so they are simply shown. */
.reveal,
[data-stack-lead],
[data-stack] .slab {
  animation: none !important;
  opacity: 1 !important;
  transform: none !important;
  filter: none !important;
}

/* Pinning measures the page. Inside a preview there is nothing to pin to. */
.turn__pin,
[data-stack],
[data-stack] .slab,
.method__head,
.trust__head {
  position: static !important;
}

/* Page furniture: fixed to the window, so in the editor it would float over
   the interface rather than sit in the block. */
.grain,
.readbar,
.orbit {
  display: none !important;
}

/* Sections set their own full-bleed backgrounds; in the canvas they are
   blocks in a column, so they keep their surface but not the page's height. */
.severus-preview .section,
.severus-preview .hero,
.severus-preview .turn {
  min-height: 0 !important;
}

.severus-preview {
  position: relative;
  pointer-events: none;
}

.severus-preview--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  min-height: 8rem;
  color: var(--ash, #8a8f98);
  font-size: 0.85rem;
}

.severus-preview__busy {
  position: absolute;
  inset: 0.75rem 0.75rem auto auto;
  opacity: 0.7;
}

/* A section in the canvas: the preview, and under it what is editable. */
.severus-block {
  display: block;
}

/* The rows below the preview: the part that is actually edited. */
.severus-block__edit {
  margin-top: 0.5rem;
  padding: 1rem;
  border: 1px solid var(--hair, rgb(255 255 255 / 12%));
  border-radius: 0.5rem;
  background: var(--pit, #0d1013);
}

.severus-block__legend {
  margin: 0 0 0.75rem;
  color: var(--ash, #8a8f98);
  font-size: 0.7rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

/* The inner-blocks container. Its own gap sets the rhythm, so the editor's
   default block margins are taken off the rows inside it. */
.severus-block__rows {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;

  & > * {
    margin-block: 0;
  }
}

.severus-row {
  padding: 0.75rem;
  border: 1px dashed var(--hair, rgb(255 255 255 / 12%));
  border-radius: 0.375rem;

  /* .severus-block__rows spaces these; the margin is for a row that is not in
     one, and collapses to nothing beside the flex gap when it is. */
  & + .severus-row {
    margin-top: 0.5rem;
  }
}

/* A row's own fields, edited in place. The names are the ones the editor
   script emits — a section's headline moved into the preview, but the row
   headings kept the class. */
.severus-section__title,
.severus-section__line {
  margin: 0;
  color: var(--bone, #f4f5f2);
}

.severus-section__title {
  font-family: var(--font-display, inherit);
  font-size: 1rem;
  font-weight: 600;
  line-height: 1.3;
}

.severus-section__line {
  color: var(--ash, #8a8f98);
  font-size: 0.85rem;
  line-height: 1.5;

  & + .severus-section__line {
    margin-top: 0.25rem;
  }
}

/* What a repeater fills is left out of the preview. It is edited as rows
   just below, so the preview would be showing it twice — and this is exactly
   the part that needs the page's JavaScript, which the canvas does not load:
   the steps would never tick, the slabs never stack, the figures never count.
   One container per section's repeater, each unique to its component. */
.severus-preview {
  & .stats,        /* hero — the strip of three */
  & .stack,        /* familiar — the slabs */
  & .steps,        /* method — the ticked steps */
  & .verticals,    /* impact — the slides */
  & .figures,      /* trust — the figures and the notes */
  & .people__grid, /* people — the team */
  & .faq__list {   /* faq — the questions */
    display: none;
  }
}

/* Impact drives a full-screen slider from the scroll position: the section is
   320svh of runway, the pin holds a viewport-tall stage, and impact.js moves
   the slides through it. None of that survives without the page's scrolling
   or its JavaScript, so the runway collapses to the height of its content and
   the stage — the slider itself — is left out. The copy around it stays. */
.severus-preview {
  & .impact {
    height: auto;
  }

  & .impact__pin {
    position: relative;
    height: auto;
  }

  & .impact__stage {
    display: none;
  }
}

/* The canvas is shown the way a reader who asked for less motion sees the
   page. This mirrors the reduce branch in src/styles/global/motion.pcss,
   which the canvas cannot reach on its own: that media query answers to the
   viewer's system setting, and someone laying out a page is not asking to
   watch it move. add_editor_style() scopes this to the editable area, so the
   admin around it is untouched. */
*,
*::before,
*::after {
  animation-duration: 0.01ms !important;
  animation-iteration-count: 1 !important;
  transition-duration: 0.01ms !important;
  scroll-behavior: auto !important;
}

/* The bridge block: a section still edited in this page's fields. */
.severus-placeholder {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  padding: 1.25rem;
  border: 1px dashed var(--hair, rgb(255 255 255 / 12%));
  border-radius: 0.5rem;
  color: var(--ash, #8a8f98);
  font-size: 0.85rem;

  & strong {
    color: var(--bone, #f4f5f2);
    font-size: 1rem;
  }
}

/* Sidebar controls that are not core components. */
.severus-field {
  margin-bottom: 1rem;

  & .severus-field__label {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
  }
}
