/* ── The editor canvas ────────────────────────────────────────────────────── */

/* The theme's own stylesheet is loaded before this one, so a section previews
   as the page will show it. What follows undoes the parts that only make sense
   while a real page is being scrolled, and dresses the editing that sits
   around the preview. */

/* Every reveal is a scroll-driven animation held at its first frame — opacity
   zero — until the element enters the viewport. In a canvas that scrolls to
   its own rules, that leaves sections blank, so they are simply shown. */
.reveal,
[data-stack-lead],
[data-stack] .slab {
  animation: none !important;
  opacity: 1 !important;
  transform: none !important;
  filter: none !important;
}

/* Pinning measures the page. Inside a preview there is nothing to pin to. */
.turn__pin,
[data-stack],
[data-stack] .slab,
.method__head,
.trust__head {
  position: static !important;
}

/* Page furniture: fixed to the window, so in the editor it would float over
   the interface rather than sit in the block. */
.grain,
.readbar,
.orbit {
  display: none !important;
}

/* Sections set their own full-bleed backgrounds; in the canvas they are
   blocks in a column, so they keep their surface but not the page's height. */
.severus-preview .section,
.severus-preview .hero,
.severus-preview .turn {
  min-height: 0 !important;
}

.severus-preview {
  position: relative;
  pointer-events: none;
}

.severus-preview--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  min-height: 8rem;
  color: var(--ash, #8a8f98);
  font-size: 0.85rem;
}

.severus-preview__busy {
  position: absolute;
  inset: 0.75rem 0.75rem auto auto;
  opacity: 0.7;
}

/* The rows below the preview: the part that is actually edited. */
.severus-block__edit {
  margin-top: 0.5rem;
  padding: 1rem;
  border: 1px solid var(--hair, rgb(255 255 255 / 12%));
  border-radius: 0.5rem;
  background: var(--pit, #0d1013);
}

.severus-block__legend {
  margin: 0 0 0.75rem;
  color: var(--ash, #8a8f98);
  font-size: 0.7rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.severus-row {
  padding: 0.75rem;
  border: 1px dashed var(--hair, rgb(255 255 255 / 12%));
  border-radius: 0.375rem;

  & + .severus-row {
    margin-top: 0.5rem;
  }
}

/* The bridge block: a section still edited in this page's fields. */
.severus-placeholder {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  padding: 1.25rem;
  border: 1px dashed var(--hair, rgb(255 255 255 / 12%));
  border-radius: 0.5rem;
  color: var(--ash, #8a8f98);
  font-size: 0.85rem;

  & strong {
    color: var(--chalk, #e8eaed);
    font-size: 1rem;
  }
}

/* Sidebar controls that are not core components. */
.severus-field {
  margin-bottom: 1rem;

  & .severus-field__label {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
  }
}
