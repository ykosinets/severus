/* ── Design tokens ─────────────────────────────────────────────────────────
   Obsidian ground, emerald and silver cut into the edges. Green is a
   highlight; silver carries the other half of the palette.
   ------------------------------------------------------------------------- */

@property --glint {
  syntax: "<percentage>";
  initial-value: 0%;
  inherits: false;
}

@property --mark {
  syntax: "<length-percentage>";
  initial-value: 0px;
  inherits: false;
}

@property --fill {
  syntax: "<percentage>";
  initial-value: 0%;
  inherits: false;
}

/* Gradients don't interpolate between two different stop lists, so animated
   edges are built from registered colours and those are what transition. */
/* Angles of the light running round an important service card. */
@property --ring-a {
  syntax: "<angle>";
  initial-value: 0deg;
  inherits: false;
}

@property --ring-b {
  syntax: "<angle>";
  initial-value: 0deg;
  inherits: false;
}

@property --face-1 {
  syntax: "<color>";
  initial-value: transparent;
  inherits: false;
}

@property --face-2 {
  syntax: "<color>";
  initial-value: transparent;
  inherits: false;
}

@property --edge-1 {
  syntax: "<color>";
  initial-value: transparent;
  inherits: false;
}

@property --edge-2 {
  syntax: "<color>";
  initial-value: transparent;
  inherits: false;
}

@property --edge-3 {
  syntax: "<color>";
  initial-value: transparent;
  inherits: false;
}

:root {
  color-scheme: dark;

  /* ground — three different blacks, so sections never read as one flat sheet */
  --void: oklch(0.146 0.010 172);
  --pit: oklch(0.112 0.012 172);
  --abyss: oklch(0.145 0.016 258);
  --deep: oklch(0.163 0.030 168);
  --slate: oklch(0.196 0.014 172);
  --hair: oklch(0.315 0.018 172);

  /* emerald — the brand */
  --jade: oklch(0.735 0.132 170);
  --jade-deep: oklch(0.560 0.112 170);
  --jade-dim: oklch(0.400 0.070 170);
  --facet: oklch(0.955 0.048 168);

  /* silver — the other half of the house colours */
  --pewter: oklch(0.760 0.022 250);
  --ice: oklch(0.880 0.052 214);

  /* recolour targets consumed by the inlined service glyphs */
  --glyph-mid: oklch(0.520 0.090 170);
  --glyph-well: oklch(0.215 0.028 170);

  /* type */
  --bone: oklch(0.968 0.005 160);
  --ash: oklch(0.740 0.010 168);
  --dust: oklch(0.590 0.010 168);

  /* Outfit throughout, as in the previous theme. */
  --font: "Outfit", "Outfit Fallback", ui-sans-serif, system-ui, sans-serif;
  --font-display: "Outfit", "Outfit Fallback", ui-sans-serif, sans-serif;

  /* rhythm */
  --gut: clamp(1.5rem, 5vw, 6rem);
  --shell: 1520px;
  --shell-narrow: 1140px;
  --bay: clamp(3.5rem, 4.55vw, 5.425rem);
  --head: 5.5rem;

  /* geometry — a squircle reads much tighter than a round corner of the same
     radius, so these are the round fallbacks at half size; the full values
     are set with corner-shape in layout.pcss. */
  --r-xs: 5px;
  --r-sm: 9px;
  --r-md: 14px;
  --r-lg: 21px;
  --r-pill: 999px;
  --edge: 2px;

  --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);

  /* breakpoints, mirrored in JS via the `theme` object */
  --bp-lap: 1024px;
  --bp-pad: 900px;
  --bp-phone: 640px;
}

/* Test-only light palette, enabled by the site-header control. */
body.is-light-theme {
  color-scheme: light;
  --void: oklch(0.972 0.010 172);
  --pit: oklch(0.942 0.012 172);
  --abyss: oklch(0.955 0.016 214);
  --deep: oklch(0.900 0.040 168);
  --slate: oklch(0.914 0.016 172);
  --hair: oklch(0.680 0.022 172);
  --jade: oklch(0.540 0.120 170);
  --jade-deep: oklch(0.430 0.100 170);
  --jade-dim: oklch(0.620 0.085 170);
  --facet: oklch(0.300 0.055 168);
  --pewter: oklch(0.435 0.020 250);
  --ice: oklch(0.360 0.052 214);
  --glyph-mid: oklch(0.470 0.095 170);
  --glyph-well: oklch(0.850 0.025 170);
  --bone: oklch(0.205 0.012 168);
  --ash: oklch(0.360 0.012 168);
  --dust: oklch(0.490 0.012 168);
  --card-red: oklch(0.750 0.090 25);
  --card-green: oklch(0.700 0.090 170);

  .turn video {
    filter: invert(1) hue-rotate(160deg);
    mix-blend-mode: color-dodge;
  }

  .btn--solid {
    color: white;
  }

  .btn--quiet:not(:hover) {
    background-image: linear-gradient(color-mix(in oklab, var(--slate) 55%, transparent), color-mix(in oklab, var(--slate) 40%, transparent)), linear-gradient(120deg, color-mix(in oklab, var(--jade) 55%, transparent), color-mix(in oklab, oklch(0.76 0.18 163.91) 40%, transparent) 1000%);
  }

  .hero .stage__play svg {
    color: #fff;
  }

  .services .card {
    background-color: var(--card-green);
    background-image: none;
    border-color: color-mix(in oklab, var(--card-green) 76%, var(--jade-deep));
    filter: brightness(1.5) saturate(0.5);

    .card__glyph {
      filter: contrast(1.33) brightness(0.66);
    }

    .card__art {
      opacity: 0.3;
      filter: invert(1) hue-rotate(180deg);
    }

    &:hover .card__art {
      opacity: .6;
    }
  }

  .familiar .slab {
    background: var(--card-red);
    background-image: none;
    border-color: color-mix(in oklab, var(--card-red) 78%, var(--ruby-deep));
  }

  .form__note {
    background: var(--card-green);
    color: white;

    &.is-bad {
      background: var(--card-red);
      color: white;
    }
  }

  .callout__shapes {
    filter: invert(1) hue-rotate(180deg);
  }

  .orbit {
    filter: invert(1) hue-rotate(180deg);
    opacity: .6;
  }

  .impact {
    .impact__stage {
      filter: invert(1) hue-rotate(180deg);
      mask-image: linear-gradient(to bottom, black, black calc(100% - 50px), transparent);
      opacity: .8;
    }
  }

  .trust .trust__mark {
    filter: invert(1) hue-rotate(180deg);
    opacity: .4;
  }

  .talk {
    &:before {
      mask-image: none;
      filter: invert(1) hue-rotate(180deg);
    }

    .form {
      background: rgba(255 255 255 / .55);
    }
  }

  .talk .talk__logo, .site-foot .custom-logo {
    filter: invert(1) hue-rotate(180deg);
  }
}
