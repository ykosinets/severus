/* ── Reset ────────────────────────────────────────────────────────────────── */

*,
*::before,
*::after {
  box-sizing: border-box;
}

* {
  margin: 0;
}

html {
  interpolate-size: allow-keywords;
  -webkit-text-size-adjust: 100%;
  scroll-behavior: smooth;
  scroll-padding-top: 6rem;
}

body {
  min-height: 100svh;
  background: var(--void);
  color: var(--bone);
  font-family: var(--font);
  font-size: clamp(1rem, 0.35vw + 0.92rem, 1.125rem);
  font-weight: 300;
  line-height: 1.62;
  letter-spacing: -0.005em;
  -webkit-font-smoothing: antialiased;
  overflow-x: clip;
}

img,
svg,
video,
canvas {
  display: block;
  max-width: 100%;
}

img {
  height: auto;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea,
select {
  font: inherit;
  color: inherit;
}

button {
  background: none;
  border: 0;
  cursor: pointer;
}

ul,
ol {
  list-style: none;
  padding: 0;
}

:focus-visible {
  outline: 2px solid var(--jade);
  outline-offset: 3px;
  border-radius: 4px;
}

::selection {
  background: color-mix(in oklab, var(--jade) 32%, transparent);
  color: var(--bone);
}

.screen-reader-text {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

.skip-link {
  position: fixed;
  inset-inline-start: 1rem;
  inset-block-start: -10rem;
  z-index: 999;
  padding: 0.75rem 1.25rem;
  background: var(--jade);
  color: var(--pit);
  border-radius: var(--r-xs);
  transition: inset-block-start 0.2s var(--ease);

  &:focus {
    inset-block-start: 1rem;
  }
}
