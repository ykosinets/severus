/* ── Typeface ─────────────────────────────────────────────────────────────
   Self-hosted, so the first paint waits on one same-origin request instead of
   a Google stylesheet plus a second hop to fonts.gstatic.com.

   The site is set in Outfit, as the previous theme was. e-Ukraine files sit
   in assets/fonts/ but are not declared (see inc/assets.php).
   ------------------------------------------------------------------------- */

/* latin */
@font-face {
  font-family: "Outfit";
  src: url("../fonts/outfit-latin.woff2") format("woff2");
  font-weight: 100 900;
  font-style: normal;
  font-display: swap;
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}

/* latin-ext */
@font-face {
  font-family: "Outfit";
  src: url("../fonts/outfit-latin-ext.woff2") format("woff2");
  font-weight: 100 900;
  font-style: normal;
  font-display: swap;
  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
}

/* The shape the page is laid out in before the real font arrives. Measured in
   the browser at 100px: Outfit is 2856.22 wide with ascent 100 and descent 26,
   Arial is 3002.05 / 91 / 21 — so the swap changes the glyphs and nothing
   else. Retune these if the display face changes. */
@font-face {
  font-family: "Outfit Fallback";
  src: local("Arial"), local("Helvetica Neue"), local("Helvetica"), local("Liberation Sans");
  size-adjust: 95.14%;
  ascent-override: 105.1%;
  descent-override: 27.3%;
  line-gap-override: 0%;
}

/* Measures are set in em, not ch. `ch` is the width of the font's own zero —
   0.657em in Outfit against 0.556em in Arial — so every ch-based max-width
   jumped 19% at the swap and rewrapped the text under the reader. The em
   values here render identically in Outfit and do not move. */

h1,
h2,
h3,
h4 {
  font-family: var(--font-display);
  font-weight: 400;
  line-height: 1.02;
  letter-spacing: -0.035em;
  text-wrap: balance;
}

p {
  text-wrap: pretty;
}

/* Accent runs. The field content in the database marks them with <span>
   (and <b> for weight); <em>/<mark> are accepted too, for anything written in
   the block editor. Both are scoped — a bare span rule would repaint plugin
   output like the cookie notice and the contact form. The arrow's own spans
   are left out (inside :where, so the rules keep their weight). */
:is(h1, h2, h3, .is-display, .is-quiet, .is-bright, .lead__text, .hero__lede, .slab__body, .card__text, .vert, .talk__text, .talk__sub, .work__text, .figure__note, .page-hero__sub, .page-hero__text, .brief__text, .brief__note, .point__text, .gain__text, .shift__text, .tile__text, .callout__text, .faq__text) :is(em, mark, span):not(:where([class^="snake-arrow"])) {
  all: unset;
  position: relative;
  color: var(--bone);
  background: linear-gradient(90deg, var(--jade), color-mix(in oklab, var(--jade) 35%, transparent)) 0 100% / 100% 2px no-repeat;
  padding-bottom: 0.1em;
}

.mark--cool {
  background-image: linear-gradient(90deg, var(--ice), color-mix(in oklab, var(--pewter) 40%, transparent)) !important;
}

/* Inside display type the accent is a colour shift, not an underline. */
:is(h1, h2, h3, .is-display) :is(em, mark, span):not(:where([class^="snake-arrow"])) {
  background: none;
  padding: 0;
  color: color-mix(in oklab, var(--facet) 72%, var(--jade));
}

/* Quiet blocks, and lines that are already coloured or large, keep the
   accent as plain emphasis. */
:is(.is-quiet, .talk__sub, .page-hero__sub, .brief__note, .shift__text) :is(em, mark, span):not(:where([class^="snake-arrow"])) {
  background: none;
  padding: 0;
  color: var(--bone);
}

.is-bright :is(em, mark, span):not(:where([class^="snake-arrow"])) {
  background: none;
  padding: 0;
  color: var(--jade);
}

:is(h1, h2, h3, .is-display, .is-quiet) :is(em, mark, span):not(:where([class^="snake-arrow"])).mark--cool {
  color: var(--ice);
  background: none !important;
}

/* <b> in the fields is weight, not colour. */
:is(.hero__lede, .lead__text, .slab__body) b {
  all: unset;
  color: var(--bone);
  font-weight: 500;
}
