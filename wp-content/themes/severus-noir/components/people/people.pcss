.people__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.5rem), 1fr));
  gap: clamp(1.25rem, 2.4vw, 2.25rem);

  @media (width <= 900px) {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: inline mandatory;
    /* Bleed out of the shell so a card can sit against the viewport edge. */
    margin-inline: calc(var(--gut) * -1);
    padding-inline: var(--gut);
    padding-block-end: 0.75rem;
    scroll-padding-inline-start: var(--gut);
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }
}

.face {
  display: grid;
  gap: 1.15rem;
  align-content: start;

  @media (width <= 900px) {
    flex: 0 0 auto;
    inline-size: min(68vw, 16.5rem);
    scroll-snap-align: start;
  }

  &:hover .face__frame img {
    filter: contrast(1) brightness(0.5);
    scale: 1.05;
  }
}

.face__frame {
  position: relative;
  overflow: hidden;
  border-radius: var(--r-md);
  border: var(--edge) solid transparent;
  background-image:
    linear-gradient(var(--pit), var(--pit)),
    linear-gradient(150deg, color-mix(in oklab, var(--pewter) 45%, transparent), color-mix(in oklab, var(--jade) 40%, transparent) 62%, transparent);
  background-origin: border-box;
  background-clip: padding-box, border-box;
  transition: background-image 0.5s var(--ease);

  & img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: contrast(1.05) brightness(0.86);
    transition:
      filter 0.6s var(--ease),
      scale 0.8s var(--ease-out);
  }
}

.face:hover .face__frame {
  background-image:
    linear-gradient(var(--pit), var(--pit)),
    linear-gradient(150deg, var(--ice), var(--jade) 58%, color-mix(in oklab, var(--pewter) 60%, transparent));
}

.face__veil {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  gap: 1rem;
  padding: clamp(1.15rem, 1.8vw, 1.6rem);
  background: linear-gradient(
    to top,
    color-mix(in oklab, var(--pit) 92%, transparent) 15%,
    color-mix(in oklab, var(--jade-deep) 22%, transparent) 100%
  );
  opacity: 0;
  translate: 0 14%;
  transition:
    opacity 0.4s var(--ease),
    translate 0.5s var(--ease-out);

  /* The panel arrives first, the words follow a beat later. */
  & > * {
    opacity: 0;
    translate: 0 0.8rem;
    transition:
      opacity 0.35s var(--ease),
      translate 0.45s var(--ease-out);
  }

  & blockquote {
    position: relative;
    padding-block-start: 1.4rem;
    font-size: 1rem;
    line-height: 1.42;
    color: var(--bone);
  }

  & p {
    font-size: 0.8rem;
    color: color-mix(in oklab, var(--ice) 55%, var(--ash));
  }
}

.face__veil blockquote::before {
  content: "“";
  position: absolute;
  inset-block-start: -0.42em;
  inset-inline-start: -0.06em;
  font-family: var(--font-display);
  font-size: 3rem;
  line-height: 1;
  color: var(--jade);
  opacity: 0.6;
}

.face:is(:hover, :focus-within) .face__veil {
  opacity: 1;
  translate: 0;

  & > * {
    opacity: 1;
    translate: 0;
    transition-delay: 0.17s;
  }
}

.face__name {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 1.1rem;
  letter-spacing: -0.02em;
}

.face__ln {
  display: grid;
  place-items: center;
  width: 1.5rem;
  height: 1.5rem;
  opacity: 0.5;
  transition: opacity 0.3s var(--ease);

  & svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  &:hover {
    opacity: 1;
  }
}

.face__role {
  color: var(--dust);
  font-size: 0.875rem;
  margin-block-start: -0.8rem;
}
