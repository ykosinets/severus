.method__head {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: clamp(2rem, 6vw, 6rem);
  align-items: start;

  @media (width <= 1024px) {
    grid-template-columns: 1fr;
  }
}

.method__title {
  font-size: clamp(2.1rem, 4.6vw, 4.8rem);
}

.method__notes {
  display: grid;
  gap: 1.5rem;
  padding-block-start: 0.75rem;
}

.method__sub {
  font-size: clamp(1.1rem, 1.4vw, 1.5rem);
  color: var(--bone);
  line-height: 1.35;
  letter-spacing: -0.02em;
}

.method__desc {
  color: var(--ash);
  max-width: 35.48em;
}

.steps {
  margin-block-start: clamp(2.5rem, 5vw, 5.5rem);
  display: grid;
}

.steps__item {
  padding-block: clamp(1.5rem, 2.8vw, 2.6rem);
  display: grid;
  /* The tick sits on the right; it stays first in the markup, so it is
     placed rather than reordered. */
  grid-template-columns: minmax(0, 1fr) clamp(3.4rem, 5.5vw, 5rem);
  gap: clamp(1rem, 3vw, 3rem);
  align-items: start;

  & p {
    grid-row: 1;
    grid-column: 1;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.5vw, 2.5rem);
    line-height: 1.22;
    letter-spacing: -0.035em;
    color: var(--dust);
    max-width: 17.08em;
    transition: color 0.45s var(--ease);
  }

  &.is-hit p {
    color: var(--bone);
  }

  @media (width <= 900px) {
    grid-template-columns: minmax(0, 1fr) 2.6rem;
  }
}

.steps__tick {
  grid-row: 1;
  grid-column: 2;
  justify-self: end;
  display: grid;
  place-items: center;
  width: clamp(3rem, 4.4vw, 4.2rem);
  aspect-ratio: 1;
  margin-block-start: 0.3em;
  border-radius: 50%;
  background: color-mix(in oklab, var(--jade) 14%, transparent);
  color: color-mix(in oklab, var(--jade) 45%, transparent);
  transition:
    color 0.45s var(--ease),
    background-color 0.45s var(--ease);

  & svg {
    width: 70%;
    height: auto;
    overflow: visible;
  }

  & path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.55s var(--ease-out);
  }

  @media (width <= 900px) {
    width: 2.4rem;
  }
}

.steps__item.is-hit .steps__tick {
  color: var(--facet);
  background: color-mix(in oklab, var(--jade) 34%, transparent);

  & path {
    stroke-dashoffset: 0;
  }
}
