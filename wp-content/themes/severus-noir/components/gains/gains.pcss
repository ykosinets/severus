.gains__list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: clamp(2rem, 5vw, 5rem);

  @media (width <= 900px) {
    grid-template-columns: 1fr;
  }
}

.gain {
  display: grid;
  grid-template-columns: 2.5rem minmax(0, 1fr);
  gap: 1.1rem;
  align-items: start;
  padding-block: clamp(1.25rem, 2.2vw, 2rem);
}

.gain__tick {
  display: grid;
  place-items: center;
  width: 2.5rem;
  aspect-ratio: 1;
  border-radius: 50%;
  background: color-mix(in oklab, var(--jade) 22%, transparent);
  color: var(--facet);

  & svg {
    width: 58%;
  }
}

.gain__title {
  font-size: clamp(1.1rem, 1.4vw, 1.4rem);
  line-height: 1.25;
}

.gain__text {
  margin-block-start: 0.5rem;
  color: var(--ash);
  font-size: 0.98rem;
}
