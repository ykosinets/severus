/* A case study's write-up: two columns of text on the services' copy
   measure, the footer's line where the editor puts a divider, a numbered
   ledger of steps and a button. */
.case-sections {
  --gap-y: clamp(1.5rem, 3vw, 2.75rem);
  position: relative;
  z-index: 2;
  padding-block: var(--gap-y) var(--bay);
}

.case-section {
  padding-block: var(--gap-y);
}

/* ── Two columns of text ────────────────────────────────────────────────── */

.case-section--columns .case-section__in {
  display: grid;
  grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  gap: clamp(1.25rem, 6vw, 6rem);
  align-items: start;

  @media (width <= 1024px) {
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1rem, 4vw, 1.75rem);
  }
}

.case-section--single .case-section__in {
  grid-template-columns: minmax(0, 1fr);
}

.case-section__text {
  font-size: clamp(1rem, 0.4vw + 1rem, 1.2rem);

  /* The body's rhythm, without pushing the first line off the column top. */
  & > :first-child {
    margin-block-start: 0;
  }

  /* Headings a step up from the body's: each reads as the one above it
     (h2 as h1, h6 as h5), and h1 a third larger again. The sizes are the
     default heading scale in em of this text (h1 2em … h5 0.83em); the
     face, weight and tracking are the theme's heading ones for all six. */
  & :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
    color: var(--bone);
  }

  & h1 {
    font-size: calc(2em * 1.33);
  }

  & h2 {
    font-size: 2em;
  }

  & h3 {
    font-size: 1.5em;
  }

  & h4 {
    font-size: 1.17em;
  }

  & h5 {
    font-size: 1em;
  }

  & h6 {
    font-size: 0.83em;
  }

  /* Text links; editor and theme buttons keep their own look (the block
     styles they need are loaded in inc/assets.php). */
  & a:not(.wp-block-button__link, .wp-element-button, .btn) {
    text-decoration: underline;
    color: var(--ice);

    &:hover {
      text-decoration: none;
    }
  }
}

/* ── Divider: the footer's rule (.site-foot::before) ────────────────────── */

.case-section--divider {
  padding-block: calc(var(--gap-y) * 0.5);
}

.case-divider {
  height: 2px;
  margin: 0;
  border: 0;
  background: linear-gradient(
    90deg,
    color-mix(in oklab, var(--jade) 60%, transparent),
    color-mix(in oklab, var(--pewter) 40%, transparent) 35%,
    transparent 85%
  );
}

/* ── Steps: the services' "How we approach it" ledger ───────────────────── */

/* The bullets share one column, sized by the longest, so the text lines up
   whether they read 01 or Step 1. */
.case-steps {
  grid-template-columns: minmax(clamp(3rem, 6vw, 5.5rem), max-content) minmax(0, 1fr);
  column-gap: clamp(1rem, 3vw, 2.5rem);

  & .point {
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: baseline;
    padding-block: clamp(1.25rem, 2.4vw, 2.25rem);
  }

  & .point__n {
    white-space: nowrap;
  }
}

/* Set like the services' point titles; .entry__body would otherwise make it
   body copy. */
.case-steps .case-steps__text {
  color: var(--bone);
  font-size: clamp(1.15rem, 1.5vw, 1.5rem);
  line-height: 1.3;

  & > :first-child {
    margin-block-start: 0;
  }

  & > * + * {
    margin-block-start: 0.5em;
  }
}

/* ── Button ─────────────────────────────────────────────────────────────── */

.case-section__button {
  display: flex;
  justify-content: flex-start;
}

.case-section__button--center {
  justify-content: center;
}

.case-section__button--right {
  justify-content: flex-end;
}
