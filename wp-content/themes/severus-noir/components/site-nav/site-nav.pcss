.nav {
  margin-inline-end: auto;

  @media (width <= 900px) {
    display: none;
  }
}

.nav__list {
  display: flex;
  align-items: center;

  & > li {
    position: relative;
  }

  & > li > a {
    display: inline-block;
    padding-block: clamp(0.9rem, 1.4vw, 1.5rem);
    padding-inline: clamp(.5rem, 1vw, 1.125rem);
    font-size: 1rem;
    color: var(--ash);
    transition: color 0.3s var(--ease);

    &[aria-current="page"],
    &:has(+ ul [aria-current="page"]) {
      color: var(--jade);
    }
  }


  & > li:is(:hover, :focus-within) > a {
    color: var(--bone);
  }
}

/* The dot marks a branch. */
.nav__list > li.menu-item-has-children > a::after {
  content: "";
  display: inline-block;
  margin-inline-start: 0.5em;
  margin-block-end: 2px;
  width: 0.3rem;
  height: 0.3rem;
  border-radius: 50%;
  background: currentColor;
  opacity: 0.5;
}

.nav__list .sub-menu {
  position: absolute;
  /* Flush against the item: a gap here is a dead zone that drops the hover. */
  inset-block-start: 100%;
  inset-inline-start: -1.25rem;
  min-width: 22rem;
  padding: 0.75rem;
  border: var(--edge) solid transparent;
  background-image:
    linear-gradient(color-mix(in oklab, var(--slate) 92%, transparent), color-mix(in oklab, var(--pit) 94%, transparent)),
    linear-gradient(150deg, color-mix(in oklab, var(--jade) 55%, transparent), color-mix(in oklab, var(--pewter) 38%, transparent) 55%, transparent);
  background-origin: border-box;
  background-clip: padding-box, border-box;
  backdrop-filter: blur(24px);
  border-radius: var(--r-md);
  box-shadow: 0 34px 80px -30px oklch(0 0 0 / 0.8);
  opacity: 0;
  visibility: hidden;
  translate: 0 -0.6rem;
  transition:
    opacity 0.3s var(--ease),
    translate 0.3s var(--ease-out),
    visibility 0.3s;

  & a {
    display: block;
    padding: 0.62rem 0.9rem;
    border-radius: var(--r-xs);
    font-size: 0.9rem;
    color: var(--ash);
    transition:
      background-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }

  & a[aria-current="page"] {
    background: color-mix(in oklab, var(--jade) 3%, transparent);
  }

  & a:hover {
    background: color-mix(in oklab, var(--jade) 12%, transparent);
    color: var(--bone);
  }

  /* Items arrive one behind the next. */
  & li {
    opacity: 0;
    translate: 0 -0.4rem;
    margin-bottom: 2px;
    transition:
      opacity 0.3s var(--ease),
      translate 0.35s var(--ease-out);

    &:last-child {
      margin-bottom: 0;
    }
  }
}

.nav__list > li:is(:hover, :focus-within) > .sub-menu {
  opacity: 1;
  visibility: visible;
  translate: 0;

  & li {
    opacity: 1;
    translate: 0;
  }
}

@supports (transition-delay: calc(sibling-index() * 1ms)) {
  .nav__list > li:is(:hover, :focus-within) > .sub-menu li {
    transition-delay: calc(sibling-index() * 32ms);
  }
}
