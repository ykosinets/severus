/* The featured image as a wide plate; the title and the facts sit on a dark
   wash over its lower edge. */
.case-hero {
  position: relative;
  z-index: 2;
  padding-block: clamp(1.5rem, 3vw, 3rem) clamp(1rem, 3vw, 2.5rem);
}

.case-hero__plate {
  position: relative;
  display: grid;
  align-items: end;
  min-block-size: clamp(26rem, 68vh, 46rem);
  border-radius: var(--r-lg);
  border: 2px solid color-mix(in oklab, var(--hair) 70%, transparent);
  overflow: hidden;
  background: var(--slate);
  isolation: isolate;

  /* The wash: clear at the top, near-solid behind the copy. */
  &::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, color-mix(in oklab, var(--pit) 94%, transparent) 0%, color-mix(in oklab, var(--pit) 70%, transparent) 38%, transparent 78%),
      linear-gradient(to right, color-mix(in oklab, var(--pit) 45%, transparent), transparent 60%);
  }

  @media (width <= 640px) {
    min-block-size: clamp(30rem, 82vh, 38rem);
  }
}

/* No cover: the Severus glow the blank case cards use. */
.case-hero__plate--blank {
  background:
    radial-gradient(60% 70% at 70% 35%, color-mix(in oklab, var(--jade) 16%, transparent), transparent 72%),
    var(--slate);
}

.case-hero__art {
  position: absolute;
  inset: 0;
  z-index: -2;
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: saturate(0.75) brightness(0.9);
}

.case-hero__copy {
  display: grid;
  gap: clamp(1.25rem, 2.5vw, 2rem);
  padding: clamp(1.5rem, 4vw, 3.5rem);
}

.case-hero__title {
  max-inline-size: 22ch;
  font-size: clamp(2.1rem, 4.4vw, 4.4rem);
  line-height: 1.08;
  color: var(--bone);
}

/* On the plate the facts lose their frame: one hairline above, no margin. */
.case-hero .facts {
  margin: 0;
  padding-block-end: 0;
  border-block-end: 0;
  border-block-start-color: color-mix(in oklab, var(--bone) 18%, transparent);
}
