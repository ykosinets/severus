.cky-consent-bar,
.cky-btn,
.cky-preference-center,
.cky-modal {
    @supports (corner-shape: squircle) {
        border-radius: var(--r-lg) !important;
        corner-shape: squircle !important;
    }
}

.cky-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 0.75em !important;
    padding: 0.95em 1.6em !important;
    border-radius: var(--r-pill) !important;
    font-size: clamp(0.875rem, 0.2vw + 0.84rem, 0.975rem) !important;
    font-weight: 400 !important;
    letter-spacing: -0.01em !important;
    line-height: 1.2 !important;
    position: relative !important;
    transition: color 0.3s var(--ease), box-shadow 0.35s var(--ease), background-image 0.4s var(--ease) !important;
    border: var(--edge) solid transparent !important;
    color: var(--bone) !important;
    background-image: linear-gradient(
            color-mix(in oklab, var(--slate) 55%, transparent),
            color-mix(in oklab, var(--slate) 40%, transparent)), linear-gradient(120deg,
            color-mix(in oklab, var(--jade) 55%, transparent),
            color-mix(in oklab, var(--pewter) 40%, transparent) 60%, transparent) !important;
}

.cky-btn:not(.cky-btn-accept) {
    background-origin: border-box !important;
    background-clip: padding-box, border-box !important;
    backdrop-filter: blur(8px) !important;
}

.cky-consent-bar,
.cky-preference-center {
    --face-1: color-mix(in oklab, var(--slate) 78%, transparent) !important;
    --face-2: color-mix(in oklab, var(--pit) 92%, transparent) !important;
    --face-3: color-mix(in oklab, var(--pit) 0%, transparent) !important;
    --edge-1: color-mix(in oklab, var(--jade) 62%, transparent) !important;
    --edge-2: color-mix(in oklab, var(--pewter) 40%, transparent) !important;
    --edge-3: color-mix(in oklab, var(--hair) 55%, transparent) !important;
    background: #111 !important;
    color: #fff !important;
    border: 2px solid var(--jade-deep) !important;
    background-image: linear-gradient(158deg, var(--face-1), var(--face-2)), linear-gradient(148deg, var(--edge-1) 0%, var(--edge-2) 34%, var(--edge-3) 62%, transparent 92%) !important;
    box-shadow: none !important;

    & * {
        color: #fff !important;
    }
}

.cky-footer-shadow {
    background: linear-gradient(
            color-mix(in oklab, var(--pit) 0%, transparent) 0%,
            color-mix(in oklab, var(--pit) 92%, transparent) 100%) !important;
}

.cky-audit-table {
    background: #222 !important;
}

.cky-btn-accept {
    background: var(--jade) !important;
    border-width: 0 !important;
    background-image: linear-gradient(112deg, var(--jade),
    color-mix(in oklab, var(--jade) 74%, var(--ice))) !important;
    color: oklch(0.16 0.03 172) !important;
    font-weight: 500 !important;
    box-shadow: 0 14px 40px -20px color-mix(in oklab, var(--jade) 75%, transparent) !important;
}

.cky-btn-revisit-wrapper {
    width: 46px !important;
    height: 46px !important;
    background: var(--jade) !important;
}

.cky-btn-close {
    width: 44px !important;
    height: 44px !important;
    padding: 14px !important;

    img {
        width: 100% !important;
        height: auto !important;
        max-width: 16px !important;
    }
}

.cky-notice-des *,
.cky-preference-content-wrapper *,
.cky-accordion-header-des *,
.cky-gpc-wrapper .cky-gpc-desc *,
.cky-audit-table .cky-empty-cookies-text {
    font-size: 1rem !important;
}

.cky-accordion-header .cky-accordion-btn {
    font-size: 1.125rem !important;
}

.cky-show-desc-btn {
    text-decoration: underline !important;
}