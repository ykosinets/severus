.shift__pair {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: clamp(1rem, 1.6vw, 1.5rem);

  @media (width <= 900px) {
    grid-template-columns: 1fr;
  }
}

.shift__panel {
  display: grid;
  gap: 1rem;
  align-content: start;
  padding: clamp(1.5rem, 3vw, 3rem);
  border-radius: var(--r-lg);
  border: 1px solid var(--hair);
}

.shift__panel--lit {
  border: var(--edge) solid transparent;
}

.shift__title {
  font-size: 0.8rem;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--dust);
}

.shift__panel--lit .shift__title {
  color: var(--jade);
}

.shift__text {
  font-size: clamp(1.1rem, 1.5vw, 1.45rem);
  line-height: 1.4;
  color: var(--ash);
}

.shift__panel--lit .shift__text {
  color: var(--bone);
}
