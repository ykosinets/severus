.points__list {
  display: grid;
  gap: clamp(1rem, 1.6vw, 1.5rem);
}

.points--cards .points__list {
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
}

.point {
  display: grid;
  gap: 1rem;
  align-content: start;
}

.points--cards .point {
  padding: clamp(1.5rem, 2.6vw, 2.5rem);
  border-radius: var(--r-lg);
}

/* The list reads as a numbered ledger: number, title, text across the row. */
.points--list .point {
  grid-template-columns: clamp(3rem, 6vw, 5.5rem) minmax(0, 1fr);
  padding-block: clamp(1.25rem, 2.4vw, 2.25rem);
}

.point__n {
  font-family: var(--font-display);
  font-size: clamp(1.6rem, 2.6vw, 2.6rem);
  line-height: 1;
  letter-spacing: -0.03em;
  color: color-mix(in oklab, var(--jade) 70%, var(--facet));
}

.point__body {
  display: grid;
  gap: 0.6rem;
}

.points--list .point__body {
  grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  gap: clamp(0.6rem, 3vw, 3rem);

  @media (width <= 900px) {
    grid-template-columns: 1fr;
  }
}

.point__title {
  font-size: clamp(1.2rem, 1.6vw, 1.6rem);
  line-height: 1.2;
}

.point__text {
  color: var(--ash);
  font-size: 1rem;
}
