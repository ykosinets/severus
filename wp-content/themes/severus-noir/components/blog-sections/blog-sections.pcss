.blog-section{padding-block:clamp(3rem,7vw,7rem)}.blog-section__grid{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:clamp(2rem,8vw,8rem)}.blog-section h2{font-size:clamp(2rem,3.5vw,3.8rem)}.blog-section__table h2{max-width:20ch;margin-bottom:clamp(2rem,4vw,4rem)}.blog-section__table .entry__body{max-width:none;overflow-x:auto}.blog-section__table table{width:100%;min-width:42rem;border-collapse:collapse}.blog-section__table th,.blog-section__table td{padding:1rem;border-bottom:1px solid color-mix(in oklab,var(--pewter) 30%,transparent);text-align:left;vertical-align:top}.blog-section__items{display:grid;gap:0;margin:clamp(2rem,4vw,4rem) 0 0;padding:0;list-style:none}.blog-section__items li{display:grid;grid-template-columns:clamp(3rem,6vw,5.5rem) minmax(0,1fr);gap:clamp(1rem,3vw,3rem);padding-block:clamp(1.25rem,2.4vw,2.25rem);border-top:1px solid color-mix(in oklab,var(--pewter) 30%,transparent)}.blog-section__items>li>div{padding-top:12px}.blog-section__items li>span{color:var(--jade);font-family:var(--font-display);font-size:2rem}.blog-section__items--ticks{grid-template-columns:repeat(2,minmax(0,1fr));column-gap:clamp(2rem,5vw,5rem)}.blog-section__items--ticks li{grid-template-columns:2rem minmax(0,1fr)}.blog-section__items--no-icon li{grid-template-columns:1fr}.blog-section__items--neutral li>span{color:var(--pewter)}.blog-section__items--green li>span{color:var(--jade)}.blog-section__items--red li>span{color:#d26d64}.blog-section__items h3{margin:0 0 .5rem;font-size:1.25rem}@media(width <= 900px){.blog-section__grid,.blog-section__items--ticks{grid-template-columns:1fr}.blog-section__table table{min-width:34rem}}
