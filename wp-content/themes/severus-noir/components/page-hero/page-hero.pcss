.page-hero {
  position: relative;
  z-index: 2;
  padding-block: clamp(2rem, 4vw, 4rem) clamp(3rem, 6vw, 6rem);
  overflow: clip;
}

.page-hero__in {
  position: relative;
  display: grid;
  gap: clamp(2rem, 5vw, 5rem);
  align-items: center;
}

.page-hero--split .page-hero__in {
  grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);

  @media (width <= 1024px) {
    grid-template-columns: 1fr;
  }
}

.page-hero__copy {
  max-width: 48rem;
}

.page-hero__title {
  font-size: clamp(2.25rem, 4.6vw, 4.8rem);
  line-height: 1.08;
}

.page-hero__sub {
  margin-block-start: clamp(1rem, 2vw, 1.75rem);
  font-size: clamp(1.2rem, 1.9vw, 1.75rem);
  line-height: 1.3;
  color: var(--jade);
}

.page-hero__text {
  margin-block-start: clamp(1rem, 2vw, 1.75rem);
  max-width: 38em;
  color: var(--ash);
  font-size: clamp(1rem, 0.4vw + 1rem, 1.2rem);

  & p + p {
    margin-block-start: 0.9em;
  }
}

.page-hero__actions {
  margin-block-start: clamp(1.75rem, 3vw, 2.5rem);
}

.page-hero__art {
  margin: 0;
  justify-self: end;

  & img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (width <= 1024px) {
    justify-self: start;
  }
}

.page-hero__art--open {
  width: min(100%, 36rem);
}

/* Service icons sit on a plate, as they did before. */
.page-hero__art--framed {
  display: grid;
  place-items: center;
  width: min(100%, 37.5rem);
  aspect-ratio: 15 / 11;
  border-radius: var(--r-lg);

  & img {
    width: 44%;
  }
}

/* Centred variant (the Services listing): title and intro on the axis. */
.page-hero--center {
  & .page-hero__copy {
    max-width: 52rem;
    margin-inline: auto;
  }

  & .page-hero__title {
    text-align: center;
  }

  & .page-hero__text {
    margin-inline: auto;
  }
}
