.site-foot {
  position: relative;
  z-index: 2;
  padding-block: clamp(3rem, 6vw, 6rem) 2.5rem;
  background: linear-gradient(to bottom, transparent, color-mix(in oklab, var(--pit) 75%, transparent));

  &::before {
    content: "";
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      color-mix(in oklab, var(--jade) 60%, transparent),
      color-mix(in oklab, var(--pewter) 40%, transparent) 35%,
      transparent 85%
    );
  }
}

.site-foot__top {
  display: grid;
  grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
  gap: clamp(2rem, 4vw, 4rem);

  @media (width <= 1024px) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (width <= 640px) {
    grid-template-columns: 1fr;
  }
}

/* With the offices column there are five: brand, contact, offices, pages,
   services. Below 1280px the brand takes its own row above the other four. */
.site-foot__top--offices {
  @media (width > 1280px) {
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 0.8fr) minmax(0, 1.1fr);
  }

  @media (1024px < width <= 1280px) {
    grid-template-columns: repeat(4, minmax(0, 1fr));

    & .site-foot__brand {
      grid-column: 1 / -1;
    }
  }
}

.site-foot__brand {
  & img {
    width: 168px;
    height: auto;
  }
}

.site-foot__claim {
  margin-block-start: 1.5rem;
  color: var(--ash);
  max-width: 19.71em;
}

.site-foot__col {
  & h3 {
    font-family: var(--font);
    font-size: 0.78rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--dust);
    margin-block-end: 1.35rem;
  }

  & .site-foot__list {
    display: grid;
    gap: 0.7rem;
  }

  & a {
    color: var(--ash);
    font-size: 1rem;
    transition: color 0.25s var(--ease);
  }

  & a:hover {
    color: var(--ice);
  }
}

.site-foot__label {
  margin-block-end: 0.35rem;
  color: var(--dust);
  font-size: 0.85rem;
}

.site-foot__mail {
  display: block;
  color: var(--bone);
  font-size: 1rem;
}

.site-foot__ln {
  display: inline-block;
  margin-block-start: 1rem;
  color: var(--ash);
  font-size: 1rem;
  box-shadow: 0 2px 0 color-mix(in oklab, var(--pewter) 45%, transparent);
  transition:
    color 0.25s var(--ease),
    box-shadow 0.25s var(--ease);

  &:hover {
    color: var(--ice);
    box-shadow: 0 2px 0 var(--jade);
  }
}

.offices {
  display: grid;
  gap: 1.1rem;
}

.office__country {
  display: flex;
  align-items: center;
  gap: 0.55rem;
  color: var(--bone);
  font-size: 1rem;

  & img {
    flex: none;
    width: 21px;
    height: auto;
    border-radius: 3px;
  }
}

.office__address {
  margin-block-start: 0.3rem;
  padding-inline-start: calc(21px + 0.55rem);
  color: var(--ash);
  font-size: 1rem;
  font-style: normal;
  line-height: 1.5;
}

.site-foot__bar {
  margin-block-start: clamp(2.5rem, 5vw, 4rem);
  padding-block-start: 1.75rem;
  color: var(--dust);
  font-size: 0.8rem;

  &::before {
    background: linear-gradient(90deg, color-mix(in oklab, var(--hair) 80%, transparent), transparent 70%);
  }
}
