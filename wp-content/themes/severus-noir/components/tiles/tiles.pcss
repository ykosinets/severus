.tiles__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  gap: clamp(1rem, 1.6vw, 1.5rem);
}

/* The picture fills the tile; the copy sits on a shade at its foot. */
.tile {
  position: relative;
  display: grid;
  min-block-size: clamp(20rem, 30vw, 26rem);
  border-radius: var(--r-lg);
  overflow: hidden;
  background: var(--slate);
  isolation: isolate;

  &:hover .tile__art img {
    scale: 1.05;
    filter: saturate(0.95) brightness(0.9);
  }

  &:hover .tile__go {
    color: var(--pit);
    background: var(--jade);
  }
}

.tile__art {
  position: absolute;
  inset: 0;
  z-index: -1;

  & img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.6) brightness(0.7);
    transition:
      scale 0.8s var(--ease-out),
      filter 0.6s var(--ease);
  }

  &::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, color-mix(in oklab, var(--pit) 94%, transparent) 10%, transparent 70%);
  }
}

.tile__body {
  align-self: end;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 0.6rem 1rem;
  align-items: end;
  padding: clamp(1.25rem, 2.2vw, 2rem);
}

.tile__title {
  font-family: var(--font-display);
  font-size: clamp(1.3rem, 1.8vw, 1.8rem);
  line-height: 1.15;
  letter-spacing: -0.03em;
  color: var(--bone);
}

.tile__text {
  grid-column: 1;
  color: var(--ash);
  font-size: 1rem;
}

.tile__go {
  grid-column: 2;
  grid-row: 1 / span 2;
  display: grid;
  place-items: center;
  width: 2.75rem;
  aspect-ratio: 1;
  border-radius: 50%;
  color: var(--bone);
  background: color-mix(in oklab, var(--bone) 12%, transparent);
  backdrop-filter: blur(8px);
  transition:
    color 0.3s var(--ease),
    background-color 0.3s var(--ease);

  & .snake-arrow {
    width: 17px;
    height: 13px;
  }
}
