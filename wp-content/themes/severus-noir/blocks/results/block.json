{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "severus/results",
    "title": "Cases",
    "category": "severus",
    "icon": "layout",
    "textdomain": "severus-noir",
    "attributes": {
        "title": {
            "type": "string",
            "default": ""
        },
        "text": {
            "type": "string",
            "default": ""
        },
        "cases": {
            "type": "array",
            "default": []
        }
    },
    "supports": {
        "html": false,
        "reusable": false,
        "lock": false
    },
    "editorScript": "severus-editor"
}
