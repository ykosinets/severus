{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "severus/impact-slide",
    "title": "Slide",
    "parent": [
        "severus/impact"
    ],
    "category": "severus",
    "icon": "minus",
    "textdomain": "severus-noir",
    "attributes": {
        "title": {
            "type": "string",
            "default": ""
        },
        "text": {
            "type": "string",
            "default": ""
        },
        "imageId": {
            "type": "number",
            "default": 0
        },
        "button": {
            "type": "object"
        }
    },
    "supports": {
        "html": false,
        "reusable": false,
        "lock": false
    },
    "editorScript": "severus-editor"
}
