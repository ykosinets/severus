{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "severus/hero",
    "title": "Hero",
    "category": "severus",
    "icon": "layout",
    "textdomain": "severus-noir",
    "attributes": {
        "title": {
            "type": "string",
            "default": ""
        },
        "intro": {
            "type": "string",
            "default": ""
        },
        "videoId": {
            "type": "number",
            "default": 0
        },
        "posterId": {
            "type": "number",
            "default": 0
        },
        "duration": {
            "type": "string",
            "default": ""
        },
        "primary": {
            "type": "object"
        },
        "secondary": {
            "type": "object"
        }
    },
    "supports": {
        "html": false,
        "reusable": false,
        "lock": false
    },
    "editorScript": "severus-editor"
}
