{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "severus/person",
    "title": "Person",
    "parent": [
        "severus/people"
    ],
    "category": "severus",
    "icon": "minus",
    "textdomain": "severus-noir",
    "attributes": {
        "photoId": {
            "type": "number",
            "default": 0
        },
        "name": {
            "type": "string",
            "default": ""
        },
        "role": {
            "type": "string",
            "default": ""
        },
        "quote": {
            "type": "string",
            "default": ""
        },
        "overlay": {
            "type": "string",
            "default": ""
        },
        "linkedin": {
            "type": "string",
            "default": ""
        }
    },
    "supports": {
        "html": false,
        "reusable": false,
        "lock": false
    },
    "editorScript": "severus-editor"
}
